# Let the video group control the internal backlight.
# brightnessctl normally goes through logind's SetBrightness, which needs an
# active seat session; the greeter only has one on a real VT. Granting the
# group write access to the sysfs attribute makes brightness work from the
# login screen regardless, and costs nothing in the user's own session.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
